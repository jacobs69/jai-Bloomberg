{
  "name": "openterminal",
  "private": true,
  "workspaces": ["server", "web"],
  "overrides": {
    "qs": "^6.16.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w server && npm run build -w web",
    "start": "npm run start -w web",
    "test": "npm run test -w server",
    "lint": "npm run lint -w web"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.22",
    "leaflet": "^1.9.4"
  }
}
