# Optional Anthropic API key for the AI Assistant widget
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Shared secret: set the same strong value on both Vercel services.
# API_URL is injected by the Vercel service binding; locally it defaults to 127.0.0.1:4000.
API_KEY=
API_KEY_FILE=
API_URL=
API_PORT=4000
API_HOST=127.0.0.1
WEB_ORIGIN=http://localhost:3000
TRUST_PROXY=

# Optional data directory and market provider headers
DATA_DIR=
YAHOO_USER_AGENT=
SEC_EDGAR_CONTACT=

# Public App URL (used for Tradejini OAuth redirect_uri)
APP_URL=

# Tradejini CubePlus Developer App credentials (https://developer.tradejini.com)
TRADEJINI_API_KEY=
TRADEJINI_API_SECRET=
